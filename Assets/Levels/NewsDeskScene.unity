  m_Script: {fileID: 11500000, guid: 721e525b97e68a94dbc5fde1a87b4435, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewsDeskController
  entries:
  - eventName: Relaxation of gun regulations
    tvTexture: {fileID: 2800000, guid: 391d821f76638ce409e33c603e0576e5, type: 3}
    subtitleLines:
    - The government has relaxed regulations on airsoft guns.
    - The industry expects an increase in demand.
  - eventName: Popularity of shooting game
    tvTexture: {fileID: 2800000, guid: aabfa8a2283e2644b877f659d36aff7e, type: 3}
    subtitleLines:
    - A recently released shooting game is gaining massive popularity.
    - Interest in airsoft guns is also on the rise.
  - eventName: Popularity of gun-action movies
    tvTexture: {fileID: 2800000, guid: f9a1090849f7f9b499db8d3a825f3c70, type: 3}
    subtitleLines:
    - A military action movie has topped the box office.
    - Sales of related goods are expected to surge.
  - eventName: Military festival opens
    tvTexture: {fileID: 2800000, guid: 1ede300451041984da34b9d19eddff0e, type: 3}
    subtitleLines:
    - A large-scale military festival is being held.
    - Equipment purchases by attendees are expected to increase.
  - eventName: Gun control following a shooting incident
    tvTexture: {fileID: 2800000, guid: d08acbe8585164b4cb02e881b0cadcac, type: 3}
    subtitleLines:
    - A shooting incident has occurred, raising public anxiety.
    - Protests are spreading, and the industry is expected to take a hit.
  - eventName: Economic recession
    tvTexture: {fileID: 2800000, guid: 012439518d8c210408a705aa7dc26cfe, type: 3}
    subtitleLines:
    - Economic indicators are on a downward trend.
    - Falling consumer confidence is raising concerns over declining sales.
  - eventName: Gun control protest
    tvTexture: {fileID: 2800000, guid: 870daa367c7d68b47a06af76f9521737, type: 3}
    subtitleLines:
    - A bill to strengthen gun control has been proposed.
    - The airsoft gun market is also expected to be affected.
  tvScreen: {fileID: 138120260}
  subtitleText: {fileID: 177458794}
  pressAnyKeyHint: {fileID: 1779065464}
  secondsPerLine: 2
